.vercel
.env*

# Worktrees de trabajo: copias del repo, nunca se commitean.
# Vivia solo en .git/info/exclude, que es LOCAL y no viaja en el clon: por eso crecieron
# hasta 75 (4,25 GB) sin aparecer nunca en `git status`.
.claude/worktrees/

# `echegaray-os-daily` es un WORKTREE de este mismo repo, no un subdirectorio.
# Sin esta linea `git add -A` lo agrega como repositorio embebido.
echegaray-os-daily/
echegaray-os-daily
