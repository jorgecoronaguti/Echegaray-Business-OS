# Echegaray Mattermost — variables del bootstrap (PR-2).
# Copiar a `.env.bootstrap` (gitignoreado) y completar con valores reales.
#   cp .env.bootstrap.example .env.bootstrap
#
# NUNCA commitear `.env.bootstrap` real: contiene la contraseña del admin inicial.
# El bootstrap NO hardcodea ninguna contraseña; todo sale de estas variables.

# ── Contenedor donde corre Mattermost (debe coincidir con el docker-compose.yml de infra) ──
MM_CONTAINER=echegaray-mm-app

# ── Administrador inicial del sistema (system admin) ────────────────────────────────
# Con este usuario se entra por primera vez a la web/app. Cambiar la contraseña
# desde la app tras el primer login es recomendable.
MM_ADMIN_EMAIL=admin@ecsas.com.ar
MM_ADMIN_USERNAME=admin
# La contraseña DEBE cumplir la política del server (config.patch.json):
# mínimo 10 caracteres, con minúscula, mayúscula y número.
# Generar una fuerte, p. ej.:  openssl rand -base64 24
MM_ADMIN_PASSWORD=CAMBIAR_por_una_contrasena_fuerte

# ── Equipo (team) principal ──────────────────────────────────────────────────────────
# MM_TEAM_NAME es el slug en la URL (minúsculas, sin espacios). No cambiarlo luego
# a la ligera: rompe los enlaces guardados a canales.
MM_TEAM_NAME=echegaray
MM_TEAM_DISPLAY_NAME=Echegaray Construcciones

# ── Config server-side a aplicar (patch declarativo) ─────────────────────────────────
# Ruta relativa a este directorio; el bootstrap la copia al contenedor y la aplica
# con `mmctl --local config patch`.
MM_CONFIG_PATCH=config.patch.json

# ── Lista declarativa de canales ─────────────────────────────────────────────────────
# Ruta relativa a este directorio. Formato: name|display-name|visibility|purpose
MM_CHANNELS_FILE=channels.txt
