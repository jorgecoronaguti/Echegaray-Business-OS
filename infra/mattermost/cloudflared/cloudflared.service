# Echegaray Business OS — Cloudflare Tunnel (chat.ecsas.com.ar) como servicio systemd.
#
# Instalación reproducible (ver ./README.md):
#   sudo install -m0755 /home/jorge/bin/cloudflared /usr/local/bin/cloudflared
#   sudo mkdir -p /etc/cloudflared
#   sudo cp config.yml /etc/cloudflared/config.yml           # con el <TUNNEL_UUID> ya reemplazado
#   sudo cp ~/.cloudflared/<TUNNEL_UUID>.json /etc/cloudflared/   # credentials-file (NO al repo)
#   sudo cp cloudflared.service /etc/systemd/system/cloudflared.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now cloudflared
#
# El túnel es SALIENTE: no requiere abrir ningún puerto entrante en la VM.

[Unit]
Description=Cloudflare Tunnel — Echegaray Mattermost (chat.ecsas.com.ar)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
# Espera red y, si Mattermost corre en Docker, el daemon de Docker (el origen es 127.0.0.1:8065).
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
# Binario en ruta estable del sistema (copiado desde /home/jorge/bin/cloudflared en la instalación).
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
# Resiliencia: reinicio permanente ante cualquier caída (regla del PR: restart=always).
Restart=always
RestartSec=5s
# Endurecimiento básico del servicio.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
# Sólo necesita leer /etc/cloudflared (config + credentials).
ReadOnlyPaths=/etc/cloudflared
# El túnel es de red saliente: no abre sockets de escucha entrantes.

[Install]
WantedBy=multi-user.target
