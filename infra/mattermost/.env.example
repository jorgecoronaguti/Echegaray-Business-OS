# Echegaray Mattermost — plantilla de configuración.
# Copiar a `.env` (que está gitignoreado) y completar con valores reales.
#   cp .env.example .env
#
# NUNCA commitear el archivo `.env` real (contiene el secreto de la base).

# Versión de la imagen de Mattermost Team Edition (pin exacto, no "latest").
MM_IMAGE_TAG=11.8.4

# PostgreSQL DEDICADO de Mattermost (aislado del Business OS).
MM_DB_USER=mmuser
MM_DB_NAME=mattermost
# Generar uno fuerte, p. ej.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
MM_DB_PASSWORD=CAMBIAR_por_un_secreto_fuerte

# URL del sitio. PR-2: hostname público estable servido por el Cloudflare Tunnel saliente.
# Mattermost lo usa para el origen del WebSocket, CSRF y los enlaces que genera.
# Para correr LOCAL sin túnel, sobreescribir en .env con: MM_SITE_URL=http://localhost:8065
MM_SITE_URL=https://chat.ecsas.com.ar

# ── Cloudflare Tunnel (PR-2, exposición pública) ────────────────────────────────────────
# Nombre lógico del túnel saliente que publica chat.ecsas.com.ar (ver ./cloudflared/).
# El túnel se crea con `cloudflared tunnel create $TUNNEL_NAME` y su UUID + credentials-file
# se cablean en cloudflared/config.yml. Esto NO es un secreto (el secreto es el .json de
# credenciales que genera Cloudflare y que NUNCA se commitea — vive en /etc/cloudflared/).
TUNNEL_NAME=echegaray-mm

# Zona horaria.
TZ=America/Argentina/San_Juan
