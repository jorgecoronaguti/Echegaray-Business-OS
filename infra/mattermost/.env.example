# Echegaray Mattermost — plantilla de configuración.
# Copiar a `.env` (que está gitignoreado) y completar con valores reales.
#   cp .env.example .env
#
# NUNCA commitear el archivo `.env` real (contiene el secreto de la base).

# Versión de la imagen de Mattermost Team Edition (pin exacto, no "latest").
MM_IMAGE_TAG=11.8.4

# PostgreSQL DEDICADO de Mattermost (aislado del Business OS).
MM_DB_USER=mmuser
MM_DB_NAME=mattermost
# Generar uno fuerte, p. ej.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
MM_DB_PASSWORD=CAMBIAR_por_un_secreto_fuerte

# URL del sitio. PR-2: hostname público estable servido por el reverse proxy Caddy.
# Mattermost lo usa para el origen del WebSocket, CSRF y los enlaces que genera.
# Para correr LOCAL sin proxy, sobreescribir en .env con: MM_SITE_URL=http://localhost:8065
MM_SITE_URL=https://chat.ecsas.com.ar

# ── Caddy — reverse proxy público (PR-2, Path B) ────────────────────────────────────────
# Hostname público que sirve Caddy. Debe coincidir con el A record en DonWeb
# (chat -> 64.176.22.159) y con el host de MM_SITE_URL.
CHAT_DOMAIN=chat.ecsas.com.ar

# Email de contacto de ACME (Let's Encrypt/ZeroSSL): recibe avisos de expiración de certificado.
# REQUERIDO para producción — completar con un correo real del equipo (p. ej. la cuenta de
# administración de ecsas.com.ar). Si se deja vacío, el Caddyfile usa admin@example.com como
# placeholder (dominio RFC reservado, NO es un mailbox real): la emisión de certificado puede
# fallar. NO es un secreto, pero completalo antes de exponer a Internet.
ACME_EMAIL=

# Zona horaria.
TZ=America/Argentina/San_Juan
