# Echegaray Mattermost — plantilla de configuración.
# Copiar a `.env` (que está gitignoreado) y completar con valores reales.
#   cp .env.example .env
#
# NUNCA commitear el archivo `.env` real (contiene el secreto de la base).

# Versión de la imagen de Mattermost Team Edition (pin exacto, no "latest").
MM_IMAGE_TAG=11.8.4

# PostgreSQL DEDICADO de Mattermost (aislado del Business OS).
MM_DB_USER=mmuser
MM_DB_NAME=mattermost
# Generar uno fuerte, p. ej.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
MM_DB_PASSWORD=CAMBIAR_por_un_secreto_fuerte

# URL del sitio. En PR-1 queda local (no expuesto). En PR-2 pasa al hostname público estable.
MM_SITE_URL=http://localhost:8065

# Zona horaria.
TZ=America/Argentina/San_Juan
