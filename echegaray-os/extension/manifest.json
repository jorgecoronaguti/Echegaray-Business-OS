{
  "manifest_version": 3,
  "name": "Echegaray OS",
  "version": "0.8.3",
  "description": "Dale directivas al cerebro del OS de Echegaray sobre tus archivos de Drive, y recibí respuestas en segundos.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://echegaray-business-os.vercel.app/*"],
  "action": { "default_title": "Echegaray OS" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" }
}
