{
  "name": "echegaray-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "orq:worker": "node orquestador/worker.mjs",
    "orq:worker:once": "node orquestador/worker.mjs --once",
    "orq:health": "node orquestador/worker.mjs --health",
    "orq:enqueue": "node orquestador/scripts/enqueue.mjs",
    "orq:smoke": "node orquestador/scripts/smoke-anthropic.mjs",
    "orq:test": "node orquestador/scripts/una-corrida-por-maquina.mjs npm run orq:test:corrida",
    "orq:test:corrida": "node --test --test-reporter=dot 'orquestador/**/*.test.mjs' '.claude/hooks/*.test.mjs' 'scripts/**/*.test.mjs' 'src/**/*.test.ts' && node orquestador/scripts/auditar-ruteo-areas.mjs > /dev/null && node orquestador/scripts/verificar-extension-zip.mjs > /dev/null",
    "orq:test:detalle": "node --test 'orquestador/**/*.test.mjs' '.claude/hooks/*.test.mjs' 'scripts/**/*.test.mjs' 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@huggingface/transformers": "^4.2.0",
    "@novnc/novnc": "^1.7.0",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "google-auth-library": "^10.9.0",
    "heic-convert": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
