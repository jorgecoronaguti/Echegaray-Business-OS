[Unit]
# PR-4.2 · Worker del enlace comunicación (inbox -> Work Fabric lane 'comunicacion'
# -> outbox -> publicar), 24x7. USER-UNIT (systemd --user, sin sudo). Copiar a
# ~/.config/systemd/user/. NO carga anthropic.env: la lane 'comunicacion' sólo
# corre el handler determinístico comunicacion.responder; nunca handlers IA.
Description=Echegaray OS - Worker de comunicación (Communication Service <-> Work Fabric)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jorge/echegaray-os/app/.claude/worktrees/deploy-comunicacion/echegaray-os
EnvironmentFile=%h/.config/echegaray-orq/comunicacion.env
ExecStart=/home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/comunicacion/worker-comunicacion.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=comunicacion-worker

[Install]
WantedBy=default.target
