# PR-4.2 · Variables del enlace comunicación (Bot + WebSocket).
# PLANTILLA — NO es un archivo de secretos. Copiar a un EnvironmentFile fuera del
# repo (convención del OS: ~/.config/echegaray-orq/comunicacion.env, chmod 600) y
# completar los secretos. NUNCA commitear los valores reales.
#
# Arquitectura definitiva: el OS se conecta SALIENTE a Mattermost como bot por
# WebSocket. NO hay endpoint HTTP entrante, NO hay outgoing webhook, NO hay relay.
# Por eso NO se cargan MM_INCOMING_* ni COMM_HTTP_* (quedaron obsoletos para este
# flujo; el endpoint HTTP sigue en el repo como capacidad latente, no se despliega).

# — Base (compartida con el OS) —
DATABASE_URL=postgres://USER:PASS@HOST:6543/postgres   # el mismo pool del Work Fabric
ORQ_DB_SSL=1                                            # 1 en Supabase; 0 sólo en PG local de prueba

# — Bot @os + WebSocket (transporte de entrada Y publicación de respuestas) —
MM_WS_URL=ws://127.0.0.1:8065/api/v4/websocket   # WS de Mattermost por red privada (wss:// si es TLS público)
MM_BASE_URL=http://127.0.0.1:8065                # API REST de Mattermost por red privada (no el dominio público)
MM_BOT_TOKEN=                                    # token del bot @os (obligatorio; fail-closed si falta)
MM_BOT_USER_ID=                                  # user_id del bot (guarda anti-eco + mención por id)
MM_BOT_USERNAME=os                               # username del bot para detectar @mención por texto

# — Worker de comunicación —
WORKER_ID=comm-1
COMM_WORKER_IDLE_MS=2000
COMM_WORKER_BUSY_MS=200
