# PR-4.1 · Variables del enlace comunicación ↔ Work Fabric.
# PLANTILLA — NO es un archivo de secretos. Copiar a un EnvironmentFile fuera del
# repo (p.ej. /etc/echegaray/comunicacion.env, chmod 600) y completar los secretos.
# NUNCA commitear los valores reales.

# — Base (compartida con el OS) —
DATABASE_URL=postgres://USER:PASS@HOST:6543/postgres   # el mismo pool del Work Fabric
ORQ_DB_SSL=1                                            # 1 en Supabase; 0 sólo en PG local de prueba

# — Seguridad del borde entrante (M7) —
MM_INCOMING_SECRET=                # secreto HMAC del ingreso firmado (obligatorio; fail-closed si falta)
MM_INCOMING_WINDOW=300             # ventana anti-replay (segundos)
MM_INCOMING_ALLOWLIST=127.0.0.1    # IPs/prefijos permitidos (Caddy/Mattermost); coma-separado
MM_INCOMING_TOKEN=                 # token del outgoing webhook de Mattermost (verificación de origen)
# COMM_DEV=1                       # SÓLO desarrollo local: habilita modo dev del verificador. NUNCA en prod.

# — Bot @os (publicar respuestas) —
MM_BASE_URL=http://127.0.0.1:8065  # API de Mattermost por red privada (no el dominio público)
MM_BOT_TOKEN=                      # token del bot @os (obligatorio para publicar; fail-closed si falta)
MM_BOT_USER_ID=                    # user_id del bot (para ignorar su propio eco)

# — Endpoint HTTP entrante (transporte) —
COMM_HTTP_HOST=127.0.0.1           # NUNCA 0.0.0.0: se publica detrás de Caddy
COMM_HTTP_PORT=8791
COMM_HTTP_PATH=/integrations/mattermost/events
COMM_HTTP_MAX_BYTES=65536
COMM_HTTP_BODY_TIMEOUT_MS=5000

# — Worker de comunicación —
WORKER_ID=comm-1
COMM_WORKER_IDLE_MS=2000
COMM_WORKER_BUSY_MS=200
