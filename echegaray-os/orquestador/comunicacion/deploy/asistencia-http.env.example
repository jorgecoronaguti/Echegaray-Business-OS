# Asistencia · Variables del servicio que atiende los clicks del mensaje interactivo.
# PLANTILLA — NO es un archivo de secretos. Copiar a un EnvironmentFile fuera del repo
# (convención del OS: ~/.config/echegaray-orq/asistencia-http.env, chmod 600) y completar.
# NUNCA commitear los valores reales.
#
# Este proceso NO razona: deliberadamente NO se le cargan las variables de Anthropic.

# — Base (el mismo pool del Work Fabric) —
DATABASE_URL=postgres://USER:PASS@HOST:6543/postgres
ORQ_DB_SSL=1

# — Bind del servidor —
# El default del código es 127.0.0.1 (seguro, pero NO alcanzable desde el contenedor de Caddy:
# ahí 127.0.0.1 es el propio contenedor). En producción se liga a la dirección del HOST en el
# bridge de la red de Mattermost, que es privada y no enrutable desde Internet:
#     docker network inspect echegaray-mattermost-net --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Si la red se recrea y cambia de subred, esta variable se actualiza (por eso NO está en el código).
ASISTENCIA_HTTP_HOST=172.18.0.1
ASISTENCIA_HTTP_PORT=8792



# — UI nativa de Mattermost —
# URL pública del callback de las acciones. Mattermost la exige para sus botones y
# desplegables; NO es una pantalla web: nadie abre un navegador. Tiene que ser alcanzable
# desde el contenedor de Mattermost, o sea la URL pública que sirve Caddy.
ASISTENCIA_ACCION_URL=https://chat.ecsas.com.ar/asistencia/accion
# Socket unix donde escucha el servicio. NO TCP: el firewall del host descarta lo que viene
# de los bridges de Docker (ver el Caddyfile). El directorio se bind-montea en Caddy.
ASISTENCIA_HTTP_SOCKET=/home/jorge/.local/run/echegaray/asistencia.sock
# Bot @os: abre el diálogo y reescribe el post.
MM_BASE_URL=http://127.0.0.1:8065
MM_BOT_TOKEN=
MM_BOT_USER_ID=
# Token del slash command de asistencia, tal como lo emite Mattermost al crearlo
# (Integraciones → Slash Commands). Sin este valor el comando queda APAGADO: el servicio
# no puede distinguir un pedido real de Mattermost de uno cualquiera y lo rechaza, así que
# el jefe de obra escribe el comando y no pasa nada. Es la causa más común de "no anda".
MM_SLASH_TOKEN_ASISTENCIA=
# OBLIGATORIA. Secreto de la integración que autentica el endpoint de acciones (los botones
# y diálogos del mensaje). Sin ella el endpoint DENIEGA todo: el mensaje se publica pero
# ningún botón responde. Se elige acá y se configura igual del lado de Mattermost.
ASISTENCIA_ACCION_SECRETO=
