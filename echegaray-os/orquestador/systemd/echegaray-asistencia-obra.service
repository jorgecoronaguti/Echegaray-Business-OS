[Unit]
Description=Echegaray OS — la obra de cada DÍA: ASISTENCIA (Sheet de nómina) → registros_hh y obra_asignacion
Documentation=file:///home/jorge/echegaray-os/produccion/echegaray-os/orquestador/scripts/asistencia-obra-por-dia.mjs
After=network-online.target
Wants=network-online.target
# ═══ POR QUÉ ESTA CONDICIÓN ═══
# El script vive en la rama feat/asistencia-obra-por-dia. Si el checkout de producción todavía no
# lo tiene, esta unidad NO debe correr: una condición no cumplida es un salteo, no un fallo.
ConditionPathExists=/home/jorge/echegaray-os/produccion/echegaray-os/orquestador/scripts/asistencia-obra-por-dia.mjs

[Service]
Type=oneshot
WorkingDirectory=/home/jorge/echegaray-os/produccion/echegaray-os
# Credenciales fuera del repo: DATABASE_URL, GOOGLE_SA_KEY_PATH, ORQ_GOOGLE_IMPERSONATE viven acá.
EnvironmentFile=%h/.config/echegaray-orq/worker.env
# 45 s no alcanza para 245 filas + catálogos cuando Drive está lento; 180 s ya es el default del resto.
Environment=ORQ_GOOGLE_FETCH_TIMEOUT_MS=180000
ExecStartPre=-/home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/scripts/produccion-al-dia.mjs
# ═══ LA VENTANA SON 45 DÍAS, NO TODA LA HISTORIA ═══
# ASISTENCIA hoy cubre un mes (08/08→07/09). Correr sobre todo el año leería el mismo Sheet y no
# encontraría planilla para 2025: sólo sumaría ruido. 45 días cubre las tres quincenas vivas —la en
# curso, la anterior y la que todavía se está liquidando— con margen para una carga atrasada.
ExecStart=/bin/sh -c 'exec /home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/scripts/asistencia-obra-por-dia.mjs --aplicar --desde $(date -d "-45 days" +%%Y-%%m-%%d)'
StandardOutput=journal
StandardError=journal
# Medido el 08/09/2026: la corrida completa (Sheet + cruce + asignaciones) tarda ~20 s. 10 min es 30×.
TimeoutStartSec=10min
