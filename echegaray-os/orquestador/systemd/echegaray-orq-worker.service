[Unit]
Description=Echegaray OS - Work Fabric worker (orquestador, 24x7)
Documentation=file:///home/jorge/echegaray-os/produccion/echegaray-os/orquestador/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jorge/echegaray-os/produccion/echegaray-os
EnvironmentFile=%h/.config/echegaray-orq/worker.env
# Credencial del Reasoner Anthropic en archivo SEPARADO (chmod 600, rotación
# independiente). El prefijo '-' lo hace opcional: si falta, el worker arranca y
# falla claro (MissingSecretError) en la primera tarea de negocio, sin exponer la
# clave en logs/Supabase/Vercel/frontend/repo.
EnvironmentFile=-%h/.config/echegaray-orq/anthropic.env
ExecStart=/home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/worker.mjs
Restart=always
RestartSec=5
# drenado ordenado: el worker atrapa SIGTERM y termina las tareas en vuelo.
# 1260 s = ENGINE_TIMEOUT_MS (20 min, el techo de una tarea del razonador) + 1 min de margen. Con 90 s
# systemd mataba a mitad una tarea larga: su lease (15 min) la dejaba colgada y después se repetía
# entera, con su costo de API. Un stop sin nada en vuelo sigue tardando ~1 ms. produccion-al-dia.mjs
# lo reinicia con --no-block para no quedarse esperando este tiempo (24/09/2026).
KillSignal=SIGTERM
TimeoutStopSec=1260
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orq-worker

[Install]
WantedBy=default.target
