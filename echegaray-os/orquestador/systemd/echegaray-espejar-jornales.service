[Unit]
Description=Echegaray OS — refresca el espejo de JORNALES (_J_OBREROS/_J_OFICINA) y registra su frescura
Documentation=file:///home/jorge/echegaray-os/app/echegaray-os/orquestador/scripts/espejar-jornales.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jorge/echegaray-os/app/echegaray-os
EnvironmentFile=/home/jorge/.config/echegaray-orq/worker.env
ExecStart=/home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/scripts/espejar-jornales.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=espejar-jornales
# El espejo lee el archivo JORNALES con la cuenta OAuth operadora y reescribe dos pestañas espejo.
# Una corrida normal tarda segundos; 5 minutos es holgado. Si el espejo no reproduce el original
# (OAuth caído, JORNALES inaccesible o espejo desfasado) el script sale con código != 0 y NO registra
# frescura: la ausencia de una lectura exitosa reciente es lo que hace visible el desfase (ver .timer).
TimeoutStartSec=300
