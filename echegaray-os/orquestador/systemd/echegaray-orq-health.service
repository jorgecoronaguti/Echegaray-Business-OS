[Unit]
Description=Echegaray OS - Work Fabric health check (oneshot)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jorge/echegaray-os/app/echegaray-os
EnvironmentFile=%h/.config/echegaray-orq/worker.env
ExecStart=/home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/worker.mjs --health
SyslogIdentifier=orq-health
