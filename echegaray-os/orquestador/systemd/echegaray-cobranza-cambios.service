[Unit]
# LA COLA QUE ESCRIBE EN COBRANZAS (pantallas 28 y 32). Escribe en el Sheet real, así que hereda
# TODAS las guardas de esa cadena y no esquiva ninguna.
#
# NO lleva ORQ_SHEETS_DESCONGELAR, y es deliberado. Esa variable es la puerta para una PERSONA que
# tipea un comando; ponerla acá la volvería un bypass permanente del freno de mano y dejaría una sola
# línea de log por proceso. El worker usa la otra puerta, la correcta para este caso: `confirmacion`
# con el nombre de quien apretó el botón en la app (cobranza_cambio.pedido_por), que se loguea en
# CADA escritura. Sin un usuario con nombre, el cambio se rechaza y no se escribe nada.
Description=Echegaray OS - Cola de cambios a la pestana Cobranzas (app -> Sheet)
Documentation=file:///home/jorge/echegaray-os/produccion/echegaray-os/orquestador/comunicacion/cobranzas/cola-cambios.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jorge/echegaray-os/produccion/echegaray-os
Environment=PATH=/home/jorge/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/echegaray-orq/worker.env
ExecStart=/home/jorge/.nvm/versions/node/v24.18.0/bin/node orquestador/scripts/procesar-cobranza-cambios.mjs
# Cada cambio son tres llamadas a Sheets (leer valores, leer fórmulas, escribir) más la relectura, y
# la corrida toma hasta 20. 180 s es holgado. Matar al escritor a mitad de camino deja la fila en
# `procesando` hasta que la recicle el lease — el timeout no es una preferencia, es la promesa de que
# nadie interrumpe una escritura por la mitad.
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cobranza-cambios

[Install]
WantedBy=default.target
