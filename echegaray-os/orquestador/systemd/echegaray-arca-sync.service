[Unit]
Description=Echegaray OS - Sync comprobantes ARCA -> Supabase (ritmo según cuota)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jorge/echegaray-os/produccion/echegaray-os
EnvironmentFile=%h/.config/echegaray-orq/worker.env
Environment=ORQ_ARCA_RITMO=1
ExecStart=/home/jorge/.nvm/versions/node/v24.18.0/bin/node scripts/arca/sync-arca.mjs
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
