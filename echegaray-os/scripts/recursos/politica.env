# POLÍTICA DE RECURSOS DEL ENTORNO DE DESARROLLO — valores efectivos.
#
# Este archivo es la ÚNICA fuente de los límites. Lo leen `ecos`, el portero de Bash y el barrido de
# huérfanos, corran desde donde corran (worktree, agente, hook, script, worker). Se instala en
# ~/.echegaray-os/recursos/politica.env; la copia del repositorio es el valor por defecto.
#
# La VM tiene 4 núcleos y 7,2 GiB. Los números de abajo NO son estéticos: salen de lo medido el
# 17/09/2026, el día que la VM llegó a 6,6 GiB usados, 8/8 GiB de swap y carga >60, y dejó sin
# responder a VS Code Remote SSH. Un `next dev` solo llegó a 2,4 GiB de RSS; `tsc --noEmit` pasa de
# 1 GiB; cada worker de Playwright levanta un Chromium de ~600 MB; `node --test` abre un proceso por
# archivo de prueba (hay 203). Cualquier combinación de dos de esas cosas ya no entra en la memoria
# física de esta máquina.

# ── CUÁNTOS PUEDEN CORRER A LA VEZ ──
# Un servidor Next de desarrollo. Un navegador. Una validación pesada (suite, typecheck, lint, build).
ECOS_MAX_NEXT=1
ECOS_MAX_BROWSER=1
ECOS_MAX_VALIDACION=1

# ── CUÁNTA MEMORIA LIBRE HACE FALTA PARA ARRANCAR (MB de MemAvailable) ──
# Por debajo de esto la tarea espera. No se lanza "a ver si entra": así se llegó al swap lleno.
ECOS_MIN_MB_NEXT=1500
ECOS_MIN_MB_BROWSER=1100
ECOS_MIN_MB_VALIDACION=1200

# ── FRENOS GENERALES ──
# Swap usado por encima de este porcentaje = la máquina ya está paginando: nada pesado arranca.
ECOS_MAX_SWAP_PCT=55
# Carga de 1 minuto por encima de esto = 2,5 tareas por núcleo. Nada pesado arranca.
ECOS_MAX_CARGA=10

# ── EMERGENCIA ──
# Con menos memoria que esto, o más swap que esto, NO se encola: se rechaza y se barren los huérfanos.
ECOS_EMERGENCIA_MB=450
ECOS_EMERGENCIA_SWAP_PCT=85

# ── HIGIENE DE /tmp ──
# /tmp es tmpfs CON CUOTA POR USUARIO: cuando se agota, ningún comando puede escribir su salida y
# las sesiones se quedan sin shell (20/09/2026: 95.657 directorios de `mkdtemp` sin dueño). El
# barrido borra los temporales de familias conocidas con más de estos días, y nunca los que algún
# proceso vivo tiene abiertos. El tope acota lo que puede tardar una corrida del timer.
ECOS_TMP_EDAD_DIAS=3
ECOS_TMP_TOPE=20000

# ── ESPERA ──
# Cuánto puede esperar una tarea en la cola antes de rendirse (segundos) y cada cuánto avisa.
ECOS_ESPERA_MAX=1800
ECOS_AVISO_CADA=30

# ── TECHOS POR CLASE (cgroup del scope; MB) ──
# MemoryHigh frena, MemoryMax mata. El tope de swap es lo que impide que una tarea de desarrollo se
# coma los 8 GiB de swap y arrastre a toda la máquina — no es "más swap", es menos.
ECOS_CGROUP_NEXT_HIGH=2200
ECOS_CGROUP_NEXT_MAX=3300
ECOS_CGROUP_NEXT_SWAP=512
ECOS_CGROUP_BROWSER_HIGH=1400
ECOS_CGROUP_BROWSER_MAX=2200
ECOS_CGROUP_BROWSER_SWAP=256
ECOS_CGROUP_VALIDACION_HIGH=2000
ECOS_CGROUP_VALIDACION_MAX=3300
ECOS_CGROUP_VALIDACION_SWAP=384
