# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key — SOLO para workers de backend confiables (VM/cron:
# scripts/flush-saldos.mjs). Bypassa RLS: NUNCA exponer en el cliente ni versionar
# el valor real. En la VM se define como variable de entorno del sistema.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL (requerido para OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (login de usuarios): se configura en Supabase Dashboard, NO aquí.
# Ver: Supabase Dashboard > Authentication > Providers > Google

# ── Orquestador / Work Fabric (núcleo autónomo, corre en la VM) ──────────────
# Postgres directo (driver pg, portable). En prod: SESSION POOLER de Supabase
# (puerto 5432). Secreto: definir en el entorno de la VM (systemd EnvironmentFile),
# NUNCA versionar el valor real. Fuente local no versionada: supabase/.temp/pooler-url
DATABASE_URL=
# Opcionales ORQ_* (ver orquestador/README.md y orquestador/lib/config.mjs):
#   ORQ_DB_SSL, ORQ_TENANT, ORQ_PROJECT, ORQ_REPO, ORQ_CONCURRENCY,
#   ORQ_POLL_INTERVAL_MS, ORQ_LEASE_SECONDS, ORQ_HEARTBEAT_MS, ORQ_MAX_ATTEMPTS,
#   ORQ_BACKOFF_BASE_MS, ORQ_WORKSPACES_DIR, ORQ_ENGINE, ORQ_LOG_LEVEL

# ── Reasoner Anthropic (motor de razonamiento del negocio, 24×7) ─────────────
# CREDENCIAL: secreto puro de entorno. En la VM va SOLO en el EnvironmentFile de
# systemd (chmod 600), NUNCA en git/logs/Vercel/frontend/Supabase. El SDK la lee
# de process.env; no pasa por el schema de config ni por el logger.
ANTHROPIC_API_KEY=
# Motor por defecto del negocio (Reasoner). El Builder (claude-cli) queda para
# desarrollo del propio OS y se fija sólo en el handler code_change.
ORQ_AI_ENGINE=anthropic-api
# Mapeo alias→ID de modelo (las rutas históricas usan sonnet/opus/haiku):
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODEL_OPUS=claude-opus-4-8
# Tuning del adaptador (todos opcionales; defaults en orquestador/lib/config.mjs):
#   ANTHROPIC_MAX_TOKENS (8000), ANTHROPIC_TIMEOUT_MS (120000),
#   ANTHROPIC_MAX_RETRIES (3), ANTHROPIC_MAX_CONCURRENCY (4),
#   ANTHROPIC_BREAKER_THRESHOLD (5), ANTHROPIC_BREAKER_COOLDOWN_MS (30000),
#   ORQ_GOVERNANCE_FULL (0 = kernel de gobernanza; 1 = CLAUDE.md completo)

# Credencial de Service Account de Google (Sheets) para los scripts de sync.
# Puede ser el JSON completo o una ruta a un archivo. Secreto: definir en el
# entorno de la VM, NUNCA versionar el valor real. Si queda vacía, los scripts
# usan scripts/google_workspace/credentials/service-account.json (gitignorado).
GOOGLE_SERVICE_ACCOUNT_JSON=
