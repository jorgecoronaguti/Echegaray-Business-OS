{
  "$schema": "design tokens del Echegaray Business OS — canónicos en echegaray-os/src/app/globals.css",
  "meta": {
    "version": "1",
    "fecha": "2026-08-20",
    "fuente": "echegaray-os/src/app/globals.css + tailwind.config.ts",
    "regla": "si un valor difiere de globals.css, gana globals.css"
  },
  "color": {
    "marca": {
      "default": "#FDC900",
      "soft": "#FEF4CF",
      "onMarca": "#1F1F1E",
      "uso": "identidad: nav activa, selección, acción primaria, línea de hoy"
    },
    "accent": {
      "default": "#30302F",
      "hover": "#454543",
      "uso": "grafito: estructura, avance, superficie oscura"
    },
    "canvas": "#F7F7F5",
    "surface": {
      "default": "#FFFFFF",
      "quiet": "#FAFAF8",
      "sunken": "#EFEEEA"
    },
    "line": {
      "default": "#E7E6E2",
      "strong": "#D7D5CF"
    },
    "ink": {
      "default": "#1F1F1E",
      "soft": "#3A3A38"
    },
    "muted": "#6B6B67",
    "faint": "#91918B",
    "pos": {
      "default": "#067647",
      "soft": "#E7F6EE"
    },
    "neg": {
      "default": "#B42318",
      "soft": "#FBEAE8"
    },
    "warn": {
      "default": "#B54708",
      "soft": "#FDF0E4"
    },
    "info": {
      "default": "#175CD3",
      "soft": "#E9F0FD"
    },
    "focus": "#2F6DF6"
  },
  "spacing": {
    "base": 8,
    "escala": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      56
    ],
    "paginaDesktop": 40,
    "paginaMobile": 16
  },
  "radius": {
    "control": 6,
    "card": 10,
    "pill": 999,
    "avatar": "50%"
  },
  "borders": {
    "hairline": 1,
    "activo": 2,
    "colores": {
      "bloque": "#E7E6E2",
      "campo": "#D7D5CF",
      "fila": "#EFEEEA"
    }
  },
  "shadows": {
    "none": "none",
    "pop": "0 4px 12px rgba(48,48,47,.09), 0 12px 28px rgba(48,48,47,.11)"
  },
  "typography": {
    "familias": {
      "sans": "IBM Plex Sans — decisión canónica; cargar por Google Fonts y actualizar tailwind fontFamily.sans",
      "mono": "IBM Plex Mono",
      "fallback": "ui-sans-serif, system-ui, Segoe UI, Helvetica Neue, Arial, sans-serif"
    },
    "escala": [
      {
        "nombre": "doc",
        "size": 28,
        "weight": 600,
        "tracking": "-0.02em"
      },
      {
        "nombre": "pantalla",
        "size": 22,
        "weight": 600,
        "tracking": "-0.01em"
      },
      {
        "nombre": "panel",
        "size": 16,
        "weight": 600
      },
      {
        "nombre": "nav2",
        "size": 14,
        "weight": 500
      },
      {
        "nombre": "cuerpo",
        "size": 13,
        "weight": 400
      },
      {
        "nombre": "secundario",
        "size": 12.5,
        "weight": 400,
        "color": "muted"
      },
      {
        "nombre": "eyebrow",
        "size": 11,
        "weight": 500,
        "tracking": "0.04em",
        "color": "faint"
      },
      {
        "nombre": "tablaHead",
        "size": 10,
        "tracking": "0.06em",
        "transform": "uppercase",
        "color": "faint"
      },
      {
        "nombre": "numerico",
        "size": 12.5,
        "familia": "mono",
        "features": "tabular-nums"
      }
    ],
    "lineHeight": {
      "parrafo": 1.5,
      "apoyo": 1.4,
      "celda": 1
    }
  },
  "sizes": {
    "headerGlobal": 48,
    "filaTabla": 46,
    "filaTablaCompacta": 38,
    "headTabla": 32,
    "filaDisclosure": 44,
    "statusBar": 56,
    "controlDesktop": 34,
    "controlMobile": 48,
    "handleSplit": 9
  },
  "split": {
    "tablaMin": 300,
    "panelMin": 340,
    "max": 760,
    "handle": 9,
    "handleReposo": "#EFEEEA",
    "handleActivo": "#FDC900"
  },
  "zIndex": {
    "contenido": 0,
    "statusBarSticky": 5,
    "headerSticky": 30,
    "menuFlotante": 40
  },
  "breakpoints": {
    "mobile": 0,
    "tablet": 768,
    "desktop": 1280,
    "referencia": 1440
  },
  "focusRing": "0 0 0 2px var(--os-surface), 0 0 0 4px color-mix(in srgb, var(--os-focus) 55%, transparent)"
}